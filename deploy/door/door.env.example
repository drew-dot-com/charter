# ${CHARTER_DOOR_HOME}/door.env (mode 600). Not secrets, but not in the repo either.
# Required: where the door's daily sweep sends USDC above CHARTER_SWEEP_KEEP (default 15 USDC). The door will not boot without it.
CHARTER_SWEEP_TO=0x0000000000000000000000000000000000000000
# CHARTER_SWEEP_KEEP=15000000
# Optional: a Base RPC for reading host channels (default https://mainnet.base.org).
# BASE_RPC_URL=
# Optional: the box's own public addresses, never fetched as a registered host.
# CHARTER_DOOR_SELF_ADDRS=37.27.86.235
# Optional: the operator's email for info.contact in /openapi.json. x402 indexes (x402scan) use it to verify
# who runs the origin and to open its merchant dashboard. Unset: the repo's issues URL only.
# CHARTER_CONTACT_EMAIL=
# The door appends one JSON line per request to requests.jsonl in its data directory (path, status, user agent,
# referrer host; no IPs, no query strings; capped at about 10 MiB). 'off' turns it off.
# CHARTER_REQUEST_LOG=off
# Optional: a CDP API key file (the JSON the CDP portal downloads, mode 400, uid 1000). Set, exact payments
# verify and settle through CDP's facilitator, which is what lists the door in CDP's Bazaar; batch stays with
# X402_FACILITATOR_URL. The path is inside the container: secrets/ is mounted at /secrets.
# CHARTER_CDP_KEY_FILE=/secrets/cdp-key.json
# Optional: the grant fund. A file holding the bearer token the fund process presents on /v1/fund/* (put it in
# secrets/, mounted read-only at /secrets; an empty file stops the door at boot). Unset: those routes do not exist.
# CHARTER_FUND_TOKEN_FILE=/secrets/fund-token
# Optional: the fund's own payer address (0x, 40 hex). Its payments are never refused as payer_blocked; losses
# are still booked. Unset: no exemption.
# CHARTER_FUND_ADDRESS=0x...
# Optional: the allowance biller. A file holding the bearer token the biller presents on /v1/biller/* (put it in
# secrets/, mounted read-only at /secrets; an empty file stops the door at boot). The allowance routes
# (/v1/allowances and /v1/biller/*) exist only when this AND CHARTER_ALLOW_ADDRESS are set.
# CHARTER_ALLOW_TOKEN_FILE=/secrets/allow-token
# Optional: the biller's own payer address (0x, 40 hex). Its payments are never refused as payer_blocked; losses
# are still booked. Unset: no exemption.
# CHARTER_ALLOW_ADDRESS=0x...
# Optional: the page a person approves an allowance on. Unset: https://charterhome.dev/allow.
# CHARTER_ALLOW_PAGE_URL=https://charterhome.dev/allow
# Optional: referral pay. A rent request can name a referral address that earns CHARTER_REFERRAL_BPS of each hour
# the renter pays (10000 = 100%; at most 5000). 0 turns it off. The live door uses 1000 and lists its own host ids
# in CHARTER_REFERRAL_HOSTS (comma list of 64-hex host ids; the full share is earned only on those hosts). With a
# rate above 0 and the grant fund on, CHARTER_FUND_ADDRESS must be set. Payouts come out of the door's wallet once a
# day, before the sweep; see docs/ops.md "Referrals".
CHARTER_REFERRAL_BPS=0
# CHARTER_REFERRAL_MIN_PAYOUT=100000
# CHARTER_REFERRAL_DAILY_CAP=5000000
# CHARTER_REFERRAL_KEEP=5000000
# CHARTER_REFERRAL_HOSTS=
