# Append to /opt/toon-relay/deploy/Caddyfile. It is a read-only single-file
# bind mount: back it up, write in place (cat new > Caddyfile, never sed -i),
# then docker cp it to deploy-caddy-1:/tmp/Caddyfile and
# caddy reload --config /tmp/Caddyfile. The door is on relay_deploy_net.
#
# Four names, one door. charterhome.dev is the canonical address: its / is the
# landing page (the door's /home), every other path is the door. The storefront
# for a browser is rent.charterhome.dev. The two old names stay as aliases for
# callers that still use them (charter.mainnet.toonprotocol.dev is an A record in
# a zone Charter does not control). DNS for charterhome.dev is at Porkbun: A and
# AAAA for the apex and rent, to 167.233.221.236 and 2a01:4f8:c015:382f::1.
#
# The pages are a module script, stylesheets and self-hosted fonts, all from the
# same origin; job screenshots arrive as data: images; every fetch is to the
# same origin (wallet RPC and signing go through the injected wallet, not the
# page). Links to Basescan and Solscan are navigations, which CSP does not
# govern. Anything else is a bug and shows up as a CSP violation in the console.
(charter_door) {
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# The approval page runs the Base Account SDK, so it gets its own, wider, connect-src. Hosts read from
	# @base-org/account 2.6.0 (dist/core/constants.js, interface/payment/constants.js, the Base chain's
	# rpcUrls, sign/base-account/Signer.js):
	#   keys.coinbase.com            the sign-in window's own host (the window itself is a popup, not governed here)
	#   rpc.wallet.coinbase.com      Coinbase wallet RPC (CB_WALLET_RPC_URL)
	#   chain-proxy.wallet.coinbase.com  Coinbase's chain proxy for Base
	#   mainnet.base.org             the Base chain's default RPC
	# Not allowed on purpose: the SDK's analytics (cca-lite.coinbase.com, as.coinbase.com) run from an inline
	# script that script-src 'self' blocks, so telemetry stays off. No Cross-Origin-Opener-Policy is set,
	# because the popup needs its opener link; the SDK refuses same-origin.
	# Caddy runs a header directive with no matcher AFTER the matched ones, so a general Content-Security-Policy
	# would overwrite the approval page's (seen live 2026-11-25). Each policy therefore has its own matcher.
	@notallow not path /allow /allow.html /allow.js
	header @notallow Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	@allow path /allow /allow.html /allow.js
	header @allow Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://keys.coinbase.com https://rpc.wallet.coinbase.com https://chain-proxy.wallet.coinbase.com https://mainnet.base.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	reverse_proxy charter-door:3701
}

charterhome.dev {
	@root path /
	rewrite @root /home
	import charter_door
}

rent.charterhome.dev, charter.167-233-221-236.sslip.io, charter.mainnet.toonprotocol.dev {
	import charter_door
}
