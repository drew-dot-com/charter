# ${CHARTER_SOCIAL_HOME}/social.env (mode 600, uid 1000). Holds the X and Gemini keys: never in the repo.
# Every setting from the spec, section 9. Required ones are uncommented; fill them on the box.
# A missing required setting keeps the loops idle; the Telegram bot still answers /status with what is missing.

# Live posting. 1 (the default) sends "would post / would reply" to Telegram and never calls X's write
# endpoints. Only exactly 0 posts.
DRY_RUN=1

# X: the account's OAuth 1.0a keys (developer app with Read and write) and its numeric user id.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_USER_ID=

# Gemini. The writer and the checker must be different models; startup refuses equal ones.
GEMINI_API_KEY=
GEMINI_MODEL_WRITE=
GEMINI_MODEL_CHECK=

# Telegram: Drew's private chat id. The bot token is a file, set in docker-compose.yml
# (TELEGRAM_BOT_TOKEN_FILE=/secrets/telegram.token); a dedicated bot, never one another process polls.
TELEGRAM_CHAT_ID=
# TELEGRAM_BOT_TOKEN_FILE=

# The site the posts may link to. Its host must not contain a default banned word (token, airdrop, presale,
# guarantee, escape, jailbreak, unfenced, toon), so no toonprotocol.dev name: startup refuses it.
CHARTER_SITE_URL=https://charterhome.dev

# Comma-separated, any case, each entry 0x and 40 hex digits. FIRST_PARTY_PAYERS (copy it from
# /etc/charter-ops/env) is required: an empty list would make Drew's own leases read as outsiders. A bad
# entry in either list keeps the loops idle and /status names it.
# PROBE_PAYERS is a never-post list and is normally EMPTY here (since 2026-11-26): any paid lease from a
# wallet that is not Drew's is posted, a paying crawler's one-hour lease included. Do not copy the ops list.
FIRST_PARTY_PAYERS=
PROBE_PAYERS=
# The door's allowance biller (the door's CHARTER_ALLOW_ADDRESS). A lease it paid is judged by the account
# behind the allowance; unset, every allowance lease would be posted as one outside wallet's.
CHARTER_ALLOW_ADDRESS=

# Daily ceilings. Defaults: 2 USD of X spend, 200 Gemini calls. The spend cap must be at least 0.20, the cost
# of one post with a link.
SPEND_CAP_USD_DAY=
GEMINI_CALLS_CAP_DAY=

# Set in docker-compose.yml; here only to name them.
# CHARTER_DOOR_URL=
# CHARTER_DATA_DIR=
# STATE_DIR=
# CONFIG_DIR=
