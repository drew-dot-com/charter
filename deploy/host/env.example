# ~/.config/charter/env in the host's VM (mode 600). Variables: docs/env.md.
# No secrets here: TOON_PASSPHRASE_FILE names the file that holds one.
CHARTER_DATA_DIR=/home/USER/.local/share/charter
CHARTER_ALLOW_IMAGES=charter-job-fetch,charter-job-python,charter-home,charter-hermes
CHARTER_RELAY_URL=wss://relay.mainnet.toonprotocol.dev
TOON_PASSPHRASE_FILE=/home/USER/.config/toon/passphrase
CHARTER_OFFER_ID=toon2-fetch-1
# One paid interval and its price: one hour at 0.007 USDC, about 5 USDC for 30 days (the defaults since 2026-11-04).
CHARTER_INTERVAL_SECONDS=3600
CHARTER_TICK_PRICE=7000
# toon status --json .agent_node.toon_apps[0].connector.ilp_address
CHARTER_ILP_BASE=g.toon.69b2a212547e7a9c
# toon describe --json .description.edgeIdentity.publicKey
CHARTER_SEAL_KEY=0x0469b2a212547e7a9c089e06cececdc52eb468209a5735cf98a3eb68ed281287e59c0097dfcb29a8b10cc9aedf22de77d4df1d5b5d5cef3502a8c47329e79e5e1b
# toon describe --json .description.httpEndpoint
CHARTER_SEAL_URL=http://ev2ocvzg6ubobqh7mnoskk2boxuo3l5grqbro6wvj4hq2ecnacaqttyd.anyone/ilp
CHARTER_HIDDEN_HOST=true
CHARTER_PROXY=socks5://172.17.0.1:9150
# Live leases at once. Each takes 1 CPU and 1 GiB of the VM while it runs, beside the toon
# node and the host itself. toon2 (4 CPUs, 3 GiB) carries 2. A restart of the host program leaves running
# containers alone; only a lease whose container is not running is closed, and such a home is re-created
# while its paid time lasts. A lease only created, not started, is closed: check first (docs/ops.md).
CHARTER_MAX_LEASES=2
# gVisor for every job, once runsc is installed and registered with docker (docs/env.md)
# CHARTER_RUNTIME=runsc
# Homes (the charter-home image). Run deploy/host/install-home.sh first: it sets up the anon and the
# bridge these name.
# Homes live at once, counted inside CHARTER_MAX_LEASES.
CHARTER_MAX_HOMES=1
# Charter's anon includes this directory; the host writes one onion service per home here.
CHARTER_ANON_HS_DIR=/home/USER/.config/charter/anon/hs.d
# The host sends this pid SIGHUP after changing hs.d.
CHARTER_ANON_PIDFILE=/home/USER/.local/share/charter/anon/anon.pid
# The host's Nostr pubkey, so the offer handed to a home box resolves `<pubkey>:<id>`;
# `toon describe --json` or the published offer event shows it.
# CHARTER_HOST_PUBKEY=
# The connector a home is handed for paying from inside the box.
CHARTER_TENANT_CONNECTOR_URL=https://connector.mainnet.toonprotocol.dev/ilp
# Optional, shown at their defaults. The last three must match anonrc and charter-home-net.sh.
# Per home: onion keys, disk image and the host's files for the box.
# CHARTER_HOME_DIR=/home/USER/.local/share/charter/homes
# The docker network charter-home-net.service makes, with its firewall.
# CHARTER_HOME_NETWORK=charter-home
# Its gateway, where anon listens; a home's DNS and proxies point here.
# CHARTER_HOME_GATEWAY=172.19.0.1
# Anon's SOCKS port (a home's ALL_PROXY).
# CHARTER_HOME_SOCKS_PORT=9050
# Anon's HTTP tunnel port (a home's HTTP_PROXY and HTTPS_PROXY).
# CHARTER_HOME_HTTP_PORT=9080
