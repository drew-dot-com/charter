# ~/.config/charter/env in the host's VM (mode 600). Variables: docs/env.md.
# No secrets here: TOON_PASSPHRASE_FILE names the file that holds one.
CHARTER_DATA_DIR=/home/USER/.local/share/charter
CHARTER_ALLOW_IMAGES=charter-job-fetch
CHARTER_RELAY_URL=wss://relay.mainnet.toonprotocol.dev
TOON_PASSPHRASE_FILE=/home/USER/.config/toon/passphrase
CHARTER_OFFER_ID=toon2-fetch-1
# toon status --json .agent_node.toon_apps[0].connector.ilp_address
CHARTER_ILP_BASE=g.toon.69b2a212547e7a9c
# toon describe --json .description.edgeIdentity.publicKey
CHARTER_SEAL_KEY=0x0469b2a212547e7a9c089e06cececdc52eb468209a5735cf98a3eb68ed281287e59c0097dfcb29a8b10cc9aedf22de77d4df1d5b5d5cef3502a8c47329e79e5e1b
# toon describe --json .description.httpEndpoint
CHARTER_SEAL_URL=http://ev2ocvzg6ubobqh7mnoskk2boxuo3l5grqbro6wvj4hq2ecnacaqttyd.anyone/ilp
CHARTER_HIDDEN_HOST=true
CHARTER_PROXY=socks5://172.17.0.1:9150
CHARTER_MAX_LEASES=1
