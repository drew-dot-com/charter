# ~/.config/charter/ops.env in the host's VM (mode 600). Read by charter-home-watch.sh and by
# the charter-alert.sh it calls. No secrets here: TELEGRAM_BOT_TOKEN_FILE names the file that holds one.

# Where alerts go. Set one or both.
TELEGRAM_BOT_TOKEN_FILE=/home/USER/.config/charter/telegram.token
TELEGRAM_CHAT_ID=
#NTFY_URL=https://ntfy.sh/<topic>

# A running home with less paid time than this has a late tick (a tenant pays 30 minutes early).
HOME_LAPSE_WARN_MINUTES=20
# charter-host's data directory, when it is not ~/.local/share/charter.
#CHARTER_DATA_DIR=/home/USER/.local/share/charter
