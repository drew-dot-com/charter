# systemd --user unit: job containers reach an Anyone SOCKS port at
# 172.17.0.1:9150. By default that is the toon node's own port, which is loopback
# only and moves at every `toon up`, so each connection reads the current port
# (charter-socks-connect). On a host whose node runs no anon (hel1, a clearnet
# node), install-home.sh with ANON_BIN set writes a drop-in,
# ~/.config/systemd/user/charter-socks.service.d/upstream.conf, setting the
# CHARTER_SOCKS_UPSTREAM shown commented below: jobs then go out through
# charter-anon's loopback SOCKS port (deploy/host/anonrc). Do not uncomment it here.
# Needs socat. Install beside charter-host.service; set CHARTER_PROXY=socks5://172.17.0.1:9150.
[Unit]
Description=Charter job egress: docker0 to an Anyone SOCKS port
After=docker.service

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Environment=CHARTER_SOCKS_UPSTREAM=127.0.0.1:9152
ExecStart=/usr/bin/socat TCP-LISTEN:9150,bind=172.17.0.1,fork,reuseaddr EXEC:%h/.local/bin/charter-socks-connect
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
