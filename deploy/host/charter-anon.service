# System unit for Charter's own Anyone client (deploy/host/anonrc), run as the
# host user. A system unit because binding DNSPort 172.19.0.1:53 needs
# CAP_NET_BIND_SERVICE, which a user unit cannot grant. A template:
# install-home.sh renders __USER__, __GROUP__ and __HOME__ (systemd's %h is
# root's home in a system unit, whatever User= says) into
# /etc/systemd/system/charter-anon.service and enables it.
[Unit]
Description=Charter homes: Anyone SOCKS, HTTP tunnel, DNS and onion services on the charter-home bridge
# Binds the bridge's gateway address, so the bridge must exist first.
After=network-online.target docker.service charter-home-net.service
Wants=network-online.target
Requires=charter-home-net.service

[Service]
User=__USER__
Group=__GROUP__
ExecStart=__HOME__/.local/bin/anon -f __HOME__/.config/charter/anon/anonrc
# charter-host sends the same signal itself when it adds or removes a home.
ExecReload=/bin/kill -HUP $MAINPID
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
# So `systemctl start docker` after a stop brings this back too.
WantedBy=docker.service
