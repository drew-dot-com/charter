# Charter's own Anyone client, for homes only (not the toon node's anon).
# A template: install-home.sh renders __HOME__ and the GeoIP paths into
# ~/.config/charter/anon/anonrc. Homes reach it on the charter-home bridge's
# gateway, and charter-host adds one onion service per home under hs.d, then
# sends SIGHUP to the pid in PidFile.
AgreeToTerms 1
DataDirectory __HOME__/.local/share/charter/anon
PidFile __HOME__/.local/share/charter/anon/anon.pid
SocksPort 172.19.0.1:9050
HTTPTunnelPort 172.19.0.1:9080
# Port 53 is why charter-anon.service grants CAP_NET_BIND_SERVICE.
DNSPort 172.19.0.1:53
ControlPort 0
Log notice file __HOME__/.local/share/charter/anon/anon.log
# Copies of the toon node's GeoIP files, made by install-home.sh.
GeoIPFile __GEOIP__
GeoIPv6File __GEOIP6__
%include __HOME__/.config/charter/anon/hs.d
