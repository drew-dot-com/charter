# Charter's own Anyone client, for homes (not the toon node's anon), and on a
# host whose node has no anon, for the host's own SOCKS needs too.
# A template: install-home.sh renders __HOME__ and the GeoIP paths into
# ~/.config/charter/anon/anonrc. Homes reach it on the charter-home bridge's
# gateway, and charter-host adds one onion service per home under hs.d, then
# sends SIGHUP to the pid in PidFile.
AgreeToTerms 1
DataDirectory __HOME__/.local/share/charter/anon
PidFile __HOME__/.local/share/charter/anon/anon.pid
SocksPort 172.19.0.1:9050
# For processes on the host only (loopback, out of the homes' reach): the job
# egress relay (charter-socks-connect with CHARTER_SOCKS_UPSTREAM) and the home
# watch's onion probe, on a host whose toon node runs no anon of its own.
SocksPort 127.0.0.1:9152
HTTPTunnelPort 172.19.0.1:9080
# Port 53 is why charter-anon.service grants CAP_NET_BIND_SERVICE.
DNSPort 172.19.0.1:53
# Job containers' names (the fetch job, on docker's default bridge) resolve here
# too when install-home.sh is given JOB_DNS_ADDR (the bridge's gateway, 172.17.0.1):
# it renders the next line to a second DNSPort, and CHARTER_JOB_DNS hands that
# address to each job. Without it the line is a comment and jobs use the
# resolvers docker gives them (the host's).
__JOB_DNS__
ControlPort 0
Log notice file __HOME__/.local/share/charter/anon/anon.log
# Copies of the GeoIP files (the toon node's, or the pinned package's), made by
# install-home.sh.
GeoIPFile __GEOIP__
GeoIPv6File __GEOIP6__
%include __HOME__/.config/charter/anon/hs.d
