# /etc/charter-ops/env on the box (root, mode 600). Read by every deploy/ops script.
# No secrets here: TELEGRAM_BOT_TOKEN_FILE names the file that holds one.

# Where alerts go. Set one or both.
TELEGRAM_BOT_TOKEN_FILE=/etc/charter-ops/telegram.token
TELEGRAM_CHAT_ID=6082398535
#NTFY_URL=https://ntfy.sh/<topic>

# Canary
CHARTER_DOOR_URL=https://charter.167-233-221-236.sslip.io
OFFER_MIN_MINUTES=5

# Headroom and daily spend (micro-USDC)
CHARTER_DOOR_DATA=/root/charter-door/data
HEADROOM_MIN=300000
UNPAID_MAX=400000

# Host channel: the toon2 host's outbound Solana channel to the box's edge, read from
# the edge connector's channel list with the operator bearer token (root can read it).
# Headroom under HOST_HEADROOM_MIN alerts; 300000 is about four days of republishes.
EDGE_CONNECTOR_URL=https://connector.167-233-221-236.sslip.io
EDGE_BEARER_TOKEN_FILE=/opt/toon-relay/deploy/rust/data/operator-bearer-token
HOST_CHANNEL_ID=8oBnwH4uFQNuuGH5tRKB36jCQ86MFgyvJwNfYpAPoJg5
HOST_HEADROOM_MIN=300000

# Homes' outside SSH check (charter-home-ssh-check.sh): uses CHARTER_DOOR_URL and CHARTER_DOOR_DATA above.
# Consecutive failed probes before it alerts (the timer runs every 5 minutes).
HOME_SSH_MISSES=3

# Outside usage (charter-usage-check.sh): a message per new lease from a wallet not listed here, per such
# lease paying a second hour, per new grant pitch and per decision. Comma-separated, any case. These are
# Drew's own wallets: the MCP test wallet, the test payer, Drew's browser wallet, the first test wallet
# (0xa954, 2026-10-17), Drew's allowance test account (0xcaa3) and the grant fund (a grant's home is reported
# through its pitch and decision instead). Jonathan's wallet (0xdfbd) was taken off 2026-11-26: any paid lease
# from a wallet that is not Drew's is an outside lease.
FIRST_PARTY_PAYERS=0x46fc689fc22c62392000598778164f859bbff93e,0xb66eb141728144bf7f26d1cad4a427b48c14c715,0x4d7b7960ce628cd1e7d9a85850f5688ac3dec8f4,0xfd80174e28cc2c0f37739659a63877c2d7544c61,0xa95483d2568ae2296e9dab3c0b203fab58446a45,0xcaa32ac8bd59741fd6aab2432cc4802fd0dca334
# The door's allowance biller (the door's CHARTER_ALLOW_ADDRESS). A lease it paid is judged by the account
# behind the allowance. Unset: every allowance lease reads as one outside wallet's.
CHARTER_ALLOW_ADDRESS=

# Paying x402 crawlers: wallets seen opening one-hour leases while paying hundreds of other x402 sellers on
# Base (2026-11-18 audit, 0x82ce added 11-23). A new lease from one sends nothing; a second hour still does.
PROBE_PAYERS=0xa1d1c0cf717402ff3651aa4873ccf96410b01978,0xc9c7b38c0942914fc8ea12063bc92dcd3b581670,0x35fe83e85f949b7235595a76782296c6c9c3c030,0xaa34bd941511cc82a19878e2efbe0bd7077e1db3,0x73cc9400bd9f086d7427d3421d79195a68bb1ea4,0x82cef1cdc34d65cf690235dc24e823a6585a6f86

# Reminder while a condition stays down (minutes). The first alert and the recovery are always sent.
REALERT_MINUTES=1440
