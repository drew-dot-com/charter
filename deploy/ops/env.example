# /etc/charter-ops/env on the box (root, mode 600). Read by every deploy/ops script.
# No secrets here: TELEGRAM_BOT_TOKEN_FILE names the file that holds one.

# Where alerts go. Set one or both.
TELEGRAM_BOT_TOKEN_FILE=/etc/charter-ops/telegram.token
TELEGRAM_CHAT_ID=6082398535
#NTFY_URL=https://ntfy.sh/<topic>

# Canary
CHARTER_DOOR_URL=https://charter.167-233-221-236.sslip.io
OFFER_MIN_MINUTES=5

# Headroom and daily spend (micro-USDC)
CHARTER_DOOR_DATA=/root/charter-door/data
HEADROOM_MIN=300000
UNPAID_MAX=400000

# Host channel: the toon2 host's outbound Solana channel to the box's edge, read from
# the edge connector's channel list with the operator bearer token (root can read it).
# Headroom under HOST_HEADROOM_MIN alerts; 300000 is about two days of republishes.
EDGE_CONNECTOR_URL=https://connector.167-233-221-236.sslip.io
EDGE_BEARER_TOKEN_FILE=/opt/toon-relay/deploy/rust/data/operator-bearer-token
HOST_CHANNEL_ID=8oBnwH4uFQNuuGH5tRKB36jCQ86MFgyvJwNfYpAPoJg5
HOST_HEADROOM_MIN=300000

# Reminder while a condition stays down (minutes). The first alert and the recovery are always sent.
REALERT_MINUTES=1440
