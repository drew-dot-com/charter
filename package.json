{
  "name": "charter",
  "version": "0.1.0",
  "description": "Compute leases on the TOON payment network. A host posts an offer, a buyer pays per interval, and a container runs the job for as long as the ticks keep arriving.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "test": "node --test --import tsx 'src/**/*.test.ts' 'web/**/*.test.ts' 'jobs/**/*.test.mjs'",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "dev:door": "tsx scripts/dev-door.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drew-dot-com/charter.git"
  },
  "homepage": "https://github.com/drew-dot-com/charter#readme",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@toon-protocol/client": "^4.2.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "express": "^5.3.0",
    "nostr-tools": "^2.10.4",
    "viem": "^2.57.7"
  },
  "bin": {
    "charter": "dist/cli.js",
    "charter-host": "dist/host/main.js",
    "charter-door": "dist/door/main.js"
  }
}
