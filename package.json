{
  "name": "charter",
  "version": "0.1.0",
  "description": "Compute leases on the TOON payment network. A host posts an offer, a buyer pays per interval, and a container runs the job for as long as the ticks keep arriving.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx 'src/**/*.test.ts' 'web/**/*.test.ts' 'jobs/**/*.test.mjs'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drew-dot-com/charter.git"
  },
  "homepage": "https://github.com/drew-dot-com/charter#readme",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@toon-protocol/client": "^4.2.0",
    "express": "^5.3.0",
    "nostr-tools": "^2.10.4"
  },
  "bin": {
    "charter": "dist/cli.js",
    "charter-host": "dist/host/main.js"
  }
}
